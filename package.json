{
  "name": "towops-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TowOps: missions to invoices to per-truck profit, for roadside-assistance fleets. Demo with fake data.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "data": "tsx scripts/generate-data.ts",
    "docs:model": "tsx scripts/generate-model-doc.ts",
    "samples": "tsx scripts/make-samples.ts",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "tsx tests/smoke.ts",
    "deploy": "npm run build && npx --yes wrangler@4.149.0 pages deploy dist --project-name towops-demo --branch main"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "jspdf": "^4.2.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "playwright-core": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
